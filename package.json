{
  "name": "comparame-esta",
  "version": "0.0.0",
  "description": "Comparar precios entre lugares a partir de las fotos de los tickets, compartiendo los precios con amigos",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "preview": "wrangler dev",
