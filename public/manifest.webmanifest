{
  "id": "/",
  "name": "Comparame esta",
  "short_name": "Comparame",
  "description": "Sacale fotos a tus tickets y mirá dónde está más barato cada producto, con los precios de tus amigos.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "share_target": {
    "action": "/api/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "archivos", "accept": ["image/*", "application/pdf", ".pdf"] }] }
  },
  "background_color": "#100F0E",
  "theme_color": "#100F0E",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
